From c14f68cf039dfbe1bd254adf736bd53c83206bdf Mon Sep 17 00:00:00 2001
From: Adam Paquette <acpaquette@usgs.gov>
Date: Wed, 8 Jul 2026 12:14:13 -0600
Subject: [PATCH] Properly handle linking against csmapi

Remove unnecessary changes to CMakeLists.txt

Revert eigen change

Newline reversions

Revert ALE and CSM submodules

Remove whitespace fix to make the patch more parseable

Added REQUIRED flag for CSM library and include directory in CMakeLists.txt

Look up csm/csm.h so CSM_INCLUDE_DIR is the parent of csm/, matching the
#include <csm/...> style used by the sources, and search the Windows
%LIBRARY_INC% / %LIBRARY_LIB% prefixes as well. Fixes the win_64_ build
failing with "Cannot open include file: 'csm/Plugin.h'".
---
 CMakeLists.txt | 49 ++++++++++++++++++++++++++++---------------------
 1 file changed, 28 insertions(+), 21 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 235e79b..8628479 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -69,15 +69,33 @@ set(USGSCSM_INCLUDE_DIRS "${CMAKE_CURRENT_SOURCE_DIR}/include/usgscsm"
                          "${CMAKE_CURRENT_SOURCE_DIR}"
 )
 
+# CSM API library.
+#
+# Sources include the CSM headers with the csm/ prefix (#include <csm/Plugin.h>),
+# so CSM_INCLUDE_DIR must be the directory *containing* csm/, not csm/ itself.
+# Searching for "csm/csm.h" with no PATH_SUFFIXES returns that parent directory;
+# PATH_SUFFIXES "csm" would return .../include/csm, making the compiler look for
+# .../include/csm/csm/Plugin.h. On Linux the injected -I$PREFIX/include masks
+# that; on Windows nothing does, so the build fails there.
+#
+# The explicit PATHS cover $CONDA_PREFIX and $PREFIX plus the Windows
+# %LIBRARY_INC% / %LIBRARY_LIB% layout; CMAKE_PREFIX_PATH (set by both build.sh
+# and bld.bat) is searched as well.
+find_path(CSM_INCLUDE_DIR NAMES "csm/csm.h"
+                          PATHS $ENV{CONDA_PREFIX}/include
+                                $ENV{PREFIX}/include
+                                $ENV{LIBRARY_INC}
+                          REQUIRED)
+find_library(CSM_LIBRARY NAMES csmapi
+                         PATHS $ENV{CONDA_PREFIX}/lib
+                               $ENV{PREFIX}/lib
+                               $ENV{LIBRARY_LIB}
+                         REQUIRED)
+message("-- Found CSM Library: ${CSM_LIBRARY}")
+message("-- Found CSM Include Directory: ${CSM_INCLUDE_DIR}")
+
 if(USGSCSM_EXTERNAL_DEPS)
   message(STATUS "Using external dependencies")
-  # CSM API library
-  find_path(CSM_INCLUDE_DIR NAMES "csm.h"
-                            PATH_SUFFIXES "csm"
-                            PATHS $ENV{CONDA_PREFIX}/include/)
-  find_library(CSM_LIBRARY csmapi PATHS $ENV{CONDA_PREFIX}/lib)
-  message("-- Found external CSM Library: ${CSM_LIBRARY}")
-  message("-- Found external CSM Include Directory: ${CSM_INCLUDE_DIR}")
 
   # Nlohmann JSON
   find_package(nlohmann_json REQUIRED)
@@ -94,16 +112,12 @@ if(USGSCSM_EXTERNAL_DEPS)
   set(PROJ_TARGET PROJ::proj)
   add_library(usgscsm SHARED ${USGSCSM_SRC_FILES})
 else()
+  set(BUILD_SHARED_LIBS OFF)
   message(STATUS "Using embedded dependencies")
-  # CSM API library
-  add_subdirectory(csm)
-  set(CSM_INCLUDE_DIR /csm)
-  set(CSM_LIBRARY csmapi)
 
   # Skip PROJ library for WebAssembly builds (projected sensor model is disabled)
   if(NOT EMSCRIPTEN)
     # First configure proj library
-    set(BUILD_SHARED_LIBS OFF)
     set(PROJ_SOURCE_DIR "${CMAKE_CURRENT_SOURCE_DIR}/PROJ")
     set(CMAKE_MODULE_PATH ${CMAKE_CURRENT_SOURCE_DIR}/PROJ/cmake ${CMAKE_MODULE_PATH})
     set(CMAKE_MODULE_PATH ${CMAKE_CURRENT_SOURCE_DIR}/PROJ/src ${CMAKE_MODULE_PATH})
@@ -679,10 +693,6 @@ else()
                             $<INSTALL_INTERFACE:include>
                             PRIVATE)
 
-  target_include_directories(ale
-                             PRIVATE
-                             ${ALE_INCLUDE_DIRS}
-  )
   set(ALE_LINKS nlohmann_json::nlohmann_json
                 Eigen3::Eigen
   )
@@ -704,9 +714,7 @@ else()
   set( CMAKE_CXX_FLAGS  "${CMAKE_CXX_FLAGS} -fPIC" )
   set( CMAKE_C_FLAGS  "${CMAKE_C_FLAGS} -fPIC" )
 
-  add_library(usgscsm SHARED ${USGSCSM_SRC_FILES}
-                             $<TARGET_OBJECTS:ale>
-  )
+  add_library(usgscsm SHARED ${USGSCSM_SRC_FILES})
 endif(USGSCSM_EXTERNAL_DEPS)
 
 set_target_properties(usgscsm PROPERTIES
@@ -746,8 +754,7 @@ endif()
 
 add_executable(usgscsm_cam_test bin/usgscsm_cam_test.cc)
 target_link_libraries(usgscsm_cam_test
-    usgscsm
-    ${CSM_LIBRARY})
+    usgscsm)
 
 install(TARGETS usgscsm
         RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR}
